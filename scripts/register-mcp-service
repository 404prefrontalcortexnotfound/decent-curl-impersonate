#!/bin/sh

set -eu

mode=apply
case ${1:-} in
    --check|--dry-run)
        mode=$1
        shift
        ;;
esac
if [ "$#" -ne 0 ]; then
    echo "usage: register-mcp-service [--check|--dry-run]" >&2
    exit 64
fi

service_url=${DECENT_CURL_MCP_URL:-http://127.0.0.1:8765/mcp}

check_agent() {
    label=$1
    shift
    if output=$("$@" 2>/dev/null) && printf '%s\n' "$output" | grep -Fq "$service_url"; then
        printf '%s: configured\n' "$label"
        return 0
    fi
    printf '%s: not configured\n' "$label"
    return 1
}

if [ "$mode" = "--check" ]; then
    status=0
    check_agent "Claude Code" claude mcp get decent-curl || status=1
    check_agent "Codex" codex mcp get decent-curl || status=1
    check_agent "Grok" grok mcp list || status=1
    exit "$status"
fi

for command_name in claude codex grok; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "register-mcp-service: missing $command_name" >&2
        exit 69
    fi
done

if [ "$mode" = "--dry-run" ]; then
    printf 'claude mcp add --transport http --scope user decent-curl %s\n' "$service_url"
    printf 'codex mcp add decent-curl --url %s\n' "$service_url"
    printf 'grok mcp add --transport http --scope user decent-curl %s\n' "$service_url"
    exit 0
fi

claude mcp remove --scope user decent-curl >/dev/null 2>&1 || true
claude mcp add --transport http --scope user decent-curl "$service_url"
codex mcp remove decent-curl >/dev/null 2>&1 || true
codex mcp add decent-curl --url "$service_url"
grok mcp add --transport http --scope user decent-curl "$service_url"

exec "$0" --check
